# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_USER: Email / App ID for confidential portal login access
ADMIN_USER="admin@mitwpu.edu.in"

# ADMIN_PASSWORD: Confidential password for administrative access
ADMIN_PASSWORD="AdminPassword123!"

# JWT_SECRET: Confidential secret key in ENV used to sign and verify JWT tokens
JWT_SECRET="ConfidentialPortalJWTSecretKey2026!WPU"

# GOOGLE_SHEET_URL: Live Google Sheet URL or published CSV link used to automatically fetch student data
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/12iD2xSdvp9b-rMu20oC1Q1xToK1eB0zi/edit"

# GOOGLE_FORM_URL: Google Form link opened when clicking the Add Student button
GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/1FAIpQLSc_ExampleForm/viewform"
